{
  "animations": {

    "default_block_primary": {
      "pullout": "iteminspect:viewmodel/default/default_block_primary_pullout.json",
      "putaway": "iteminspect:viewmodel/default/default_block_primary_putaway.json"
    },

    "default_block_secondary": {
      "pullout": "iteminspect:viewmodel/default/default_block_secondary_pullout.json",
      "putaway": "iteminspect:viewmodel/default/default_block_secondary_putaway.json"
    },

    "empty_main": {
      "pullout": "iteminspect:viewmodel/empty/empty_primary_pullout.json",
      "putaway": "iteminspect:viewmodel/empty/empty_primary_putaway.json"
    },

    "empty_inspect": "iteminspect:viewmodel/empty/empty_both_inspect.json",
    "default_block_both_inspect": "iteminspect:viewmodel/default/default_block_both_inspect.json"
  },

  "equip": {
    "main_hand": {
      "rules": [
        {
          "empty": true,
          "animation": "empty_main"
        },
        {
          "block_item": true,
          "animation": "default_block_primary"
        }
      ]
    },
    "offhand": {
      "rules": [
        {
          "block_item": true,
          "animation": "default_block_secondary"
        }
      ]
    }
  },

  
  "inspect": {
    "rules": [
      {
        "animation": "empty_inspect",
        "main_hand": {
          "empty": true
        },
        "offhand": {
          "empty": true
        }
      },
      {
        "animation": "default_block_both_inspect",
        "main_hand": {
          "block_item": true
        },
        "offhand": {
          "block_item": true
        }
      }
    ]
  }
}
